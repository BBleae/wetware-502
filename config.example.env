# Copy to .local/config.env and fill in your own environment.
# WETWARE_VM is the management SSH target (usually port 22, key auth).
WETWARE_VM=ubuntu@192.0.2.10
# WETWARE_VM_IP is the node's primary address (used by scripts/tests).
WETWARE_VM_IP=192.0.2.10
# Honeypot entry point (port 2222, any password / any public key).
WETWARE_HONEYPOT=root@192.0.2.10:2222
# Optional: a private-network host used to verify egress isolation.
WETWARE_PRIVATE_PROBE=192.0.2.5
# SSH key used for management (do not commit the key itself).
WETWARE_SSH_KEY=~/.ssh/id_ed25519
# Hostname to set on the node.
WETWARE_HOSTNAME=prod-cortex-04
